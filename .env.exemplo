# Copie para .env e preencha. O .env NUNCA vai para o Git (.gitignore).
# Em produção (REDE_ALIMENTA_AMBIENTE=producao) a API não sobe sem os segredos abaixo.
REDE_ALIMENTA_AMBIENTE=producao

# Chaves HMAC (gere com: python -c "import secrets; print(secrets.token_hex(32))")
REDE_ALIMENTA_CHAVE_HMAC=
REDE_ALIMENTA_CHAVE_PSEUDONIMO=
REDE_ALIMENTA_CHAVE_LOG=

# Chave privada RSA da Declaração de Doação (PEM em uma linha com \n, ou monte um arquivo e use
# REDE_ALIMENTA_CHAVE_DECLARACAO=/caminho/chave.pem)
REDE_ALIMENTA_CHAVE_DECLARACAO_PEM=

# Chaves de API: só os SHA-256 (gere com: python -m src.api.chaves)
REDE_ALIMENTA_CHAVES_API=

# Supabase: conexão da API com o papel rede_api (string do "Session pooler", porta 5432)
REDE_ALIMENTA_DATABASE_URL=
# Dashboard: conexão de LEITURA com o papel rede_dashboard
REDE_ALIMENTA_DASHBOARD_DB_URL=

# Só para o perfil banco-local do Compose
POSTGRES_SENHA_LOCAL=
